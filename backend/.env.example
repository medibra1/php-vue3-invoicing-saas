APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invoicepro
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# firebase/php-jwt v7 enforces a minimum key length per algorithm
# (>= 32 bytes / 256 bits for HS256) — generate one with e.g.
# `openssl rand -base64 32`.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes-long
JWT_ALGO=HS256
JWT_TTL=3600

CORS_ALLOWED_ORIGINS=http://localhost:5173
