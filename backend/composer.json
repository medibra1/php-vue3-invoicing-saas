{
    "name": "invoicepro/backend",
    "description": "Multi-tenant invoicing/quoting API — homemade PHP framework (PSR-7/15/11)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/container": "^2.0",
        "firebase/php-jwt": "^7.1",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "zircote/swagger-php": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix"
    }
}
