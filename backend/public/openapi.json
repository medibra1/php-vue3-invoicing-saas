                    "201": {
                        "description": "The newly created invoice, with items"
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "422": {
                        "description": "Quote is not accepted"
                    }
                }
            }
        },
        "/api/v1/stats/dashboard": {
            "get": {
                "tags": [
                    "Stats"
                ],
                "summary": "Snapshot + time-series metrics for the dashboard (revenue, overdue, quotes)",
                "operationId": "1a3435f0b0d1c7069c0d88482608f7e4",
                "responses": {
                    "200": {
                        "description": "Dashboard metrics"
                    }
                }
            }
        }
    },
