                "responses": {
                    "200": {
                        "description": "Updated, with items"
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "422": {
                        "description": "Not a draft, or invalid input"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Quotes"
                ],
                "summary": "Soft-delete a draft quote",
                "operationId": "6c4994f0c55e76ed56a9bf38b78ecae6",
                "responses": {
                    "204": {
                        "description": "Deleted"
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "422": {
                        "description": "Not a draft"
                    }
                }
            }
        },
        "/api/v1/quotes/{id}/status": {
            "post": {
                "tags": [
                    "Quotes"
                ],
                "summary": "Move a quote to its next status (draft->sent->accepted/rejected/expired)",
                "operationId": "a261c588196a4e4ddf9f6d04b96b9a0c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "status"
                                ],
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "sent",
                                            "accepted",
                                            "rejected",
                                            "expired"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated"
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "422": {
                        "description": "Transition not allowed from the current status"
                    }
                }
            }
        },
