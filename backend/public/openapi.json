                                            "properties": {
                                                "description": {
                                                    "type": "string"
                                                },
                                                "quantity": {
                                                    "type": "number"
                                                },
                                                "unit_price": {
                                                    "type": "number"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created, with items"
                    },
                    "422": {
                        "description": "Invalid client or items"
                    }
                }
            }
        },
        "/api/v1/quotes/{id}": {
            "get": {
                "tags": [
                    "Quotes"
                ],
                "summary": "Show a single quote with its line items",
